import os
import uuid
import threading
import json

from datetime import datetime, timezone
from flask import Flask, request, jsonify, render_template

from ingestion.ingestion import ingest_bundle


BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UPLOAD_DIR = os.path.join(BASE_DIR, "uploads")
REPORT_DIR = os.path.join(BASE_DIR, "validation", "reports")

MAX_UPLOAD_SIZE = 100 * 1024 * 1024

os.makedirs(UPLOAD_DIR, exist_ok=True)
os.makedirs(REPORT_DIR, exist_ok=True)

app = Flask(__name__)

app.config["MAX_CONTENT_LENGTH"] = MAX_UPLOAD_SIZE

jobs = {}
jobs_lock = threading.Lock()


def process_upload(job_id, filepath, season):

    try:
        with jobs_lock:
            jobs[job_id]["status"] = "VALIDATING"
            jobs[job_id]["message"] = "Validating season archive"

        result = ingest_bundle(
            filepath,
            season,
            dry_run=False
        )

        with jobs_lock:
            jobs[job_id]["status"] = "COMPLETED"
            jobs[job_id]["message"] = "Successfully uploaded to HDFS"
            jobs[job_id]["result"] = result
            jobs[job_id]["completed_at"] = datetime.now(
                timezone.utc
            ).isoformat()

    except Exception as exc:

        with jobs_lock:
            jobs[job_id]["status"] = "FAILED"
            jobs[job_id]["message"] = str(exc)

    finally:
        if os.path.exists(filepath):
            os.remove(filepath)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/upload", methods=["POST"])
def upload():

    if "file" not in request.files:
        return jsonify({"error": "No ZIP file provided"}), 400

    file = request.files["file"]
    season = request.form.get("season", "").strip()

    if not season.isdigit() or len(season) != 4:
        return jsonify({"error": "Enter a valid four-digit season"}), 400

    if not file.filename or not file.filename.lower().endswith(".zip"):
        return jsonify({"error": "Please upload a ZIP archive"}), 400

    job_id = str(uuid.uuid4())

    filepath = os.path.join(
        UPLOAD_DIR,
        job_id + ".zip"
    )

    file.save(filepath)

    with jobs_lock:
        jobs[job_id] = {
            "job_id": job_id,
            "season": season,
            "status": "QUEUED",
            "message": "Upload received",
            "created_at": datetime.now(timezone.utc).isoformat()
        }

    thread = threading.Thread(
        target=process_upload,
        args=(job_id, filepath, season),
        daemon=True
    )

    thread.start()

    return jsonify({
        "job_id": job_id,
        "status": "QUEUED",
        "message": "Upload received successfully"
    }), 202


@app.route("/api/jobs/<job_id>")
def job_status(job_id):

    with jobs_lock:
        job = jobs.get(job_id)

        if job is None:
            return jsonify({"error": "Job not found"}), 404

        return jsonify(job)


@app.route("/api/health")
def health():

    return jsonify({
        "application": "F1 Race Analytics",
        "status": "ONLINE",
        "hadoop_home": os.environ.get("HADOOP_HOME"),
        "hdfs_base": "/f1_data"
    })


@app.errorhandler(413)
def file_too_large(error):
    return jsonify({"error": "ZIP file exceeds 100 MB"}), 413


if __name__ == "__main__":

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=False,
        threaded=True
    )
