:root {
    --red:#e10600;
    --bg:#090b0f;
    --card:#151922;
    --card2:#1b202a;
    --border:#2a303c;
    --muted:#929baa;
    --white:#f5f6f8;
    --green:#42d6a0;
    --blue:#42a5f5;
}
* {box-sizing:border-box;margin:0;padding:0}
body {background:var(--bg);color:var(--white);font-family:Inter,"Segoe UI",Arial,sans-serif}
.header {height:70px;padding:0 6%;display:flex;justify-content:space-between;align-items:center;background:#101319;border-bottom:1px solid var(--border)}
.logo {display:flex;align-items:center;gap:13px;font-weight:800;letter-spacing:1px;font-size:14px}
.logo img {width:54px;height:auto}
.logo b {color:var(--red)}
.connection {font-size:10px;color:var(--green);letter-spacing:.6px}
.connection i {display:inline-block;width:7px;height:7px;background:var(--green);border-radius:50%;margin-right:7px}
.container {max-width:1500px;margin:auto;padding:34px 5% 20px}
.upload-section {padding:30px;background:linear-gradient(115deg,#241316,#171b24 65%);border:1px solid #4a2c32;border-radius:14px}
.eyebrow {font-size:10px;color:#e75a55;letter-spacing:1.5px;font-weight:700;margin-bottom:8px}
.upload-section h1 {font-size:clamp(25px,3vw,36px);margin-bottom:8px}
.upload-section p:not(.eyebrow) {font-size:13px;color:var(--muted)}
#uploadForm {display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
.file-button {background:#10141c;border:1px solid var(--border);padding:13px 16px;border-radius:7px;min-width:220px;cursor:pointer;font-size:12px}
#uploadButton {background:var(--red);border:0;border-radius:7px;padding:13px 22px;color:white;font-size:11px;font-weight:800;cursor:pointer}
#uploadButton:disabled {opacity:.55;cursor:wait}
.message {margin-top:12px;overflow-wrap:anywhere}
.processing {margin-top:16px;padding:17px 19px;background:var(--card);border:1px solid var(--border);border-radius:10px}
.process-line,.process-meta {display:flex;justify-content:space-between;gap:12px;align-items:center}
#jobStatus {font-size:11px;color:var(--green);font-weight:800}
#jobMessage,.process-meta {font-size:11px;color:var(--muted)}
.progress-track {height:5px;background:#303641;border-radius:20px;margin:13px 0 9px;overflow:hidden}
#progressBar {height:100%;width:0;background:var(--red);transition:width .35s}
.section {margin-top:37px}
.section-title {display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:17px}
.section-title h2 {font-size:21px}
.section-title>span {font-size:10px;color:var(--muted)}
.stats-grid {display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.stat,.panel,.highlight {background:var(--card);border:1px solid var(--border);border-radius:11px;padding:20px}
.stat small,.highlight small {font-size:10px;letter-spacing:1px;color:var(--muted);font-weight:700}
.stat h2 {font-size:31px;margin-top:12px}
.highlights-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.highlight {min-height:125px;background:linear-gradient(140deg,var(--card2),var(--card))}
.highlight h2 {font-size:21px;margin:13px 0 5px;overflow-wrap:anywhere}
.highlight p {font-size:12px;color:var(--muted)}
.winner-card {border-color:#70413b;background:linear-gradient(140deg,#321b1b,#171a22)}
.winner-card small {color:#ff8a75}
.charts-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.panel h3 {font-size:13px;margin-bottom:18px}
.chart-wrap {height:300px;position:relative}
.short-chart {height:260px}
.table-scroll {width:100%;overflow-x:auto}
table {width:100%;border-collapse:collapse;white-space:nowrap;font-size:12px}
th {text-align:left;color:var(--muted);font-size:10px;letter-spacing:.7px;font-weight:700;padding:12px;border-bottom:1px solid var(--border)}
td {padding:12px;border-bottom:1px solid #252b35}
tbody tr:hover {background:#202631}
td:first-child {font-weight:700}
.unavailable {border-style:dashed}
.unavailable p {font-size:12px;color:var(--muted);margin-top:8px}
footer {margin-top:48px;padding:22px 0;border-top:1px solid var(--border);font-size:10px;letter-spacing:1px;color:var(--muted)}
@media(max-width:900px) {
    .stats-grid {grid-template-columns:repeat(2,1fr)}
    .highlights-grid {grid-template-columns:repeat(2,1fr)}
}
@media(max-width:650px) {
    .charts-grid {grid-template-columns:1fr}
    .container {padding:22px 4%}
    .header {padding:0 4%}
    .process-line {align-items:flex-start;flex-direction:column}
}
@media(max-width:430px) {
    .stats-grid,.highlights-grid {grid-template-columns:1fr}
    #uploadForm {flex-direction:column}
    .file-button,#uploadButton {width:100%;text-align:center}
}
