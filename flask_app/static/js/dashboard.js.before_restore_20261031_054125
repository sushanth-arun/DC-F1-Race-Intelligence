// TOP PERFORMANCE CARDS
function renderTopPerformance(data) {
    const set = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value ?? "Data unavailable";
    };

    const valid = value =>
        value !== null && value !== undefined && value !== "" && value !== "Unavailable";

    const winner = data.winner;
    set("winnerName", valid(winner) ? winner : "Data unavailable");
    set("winnerTeam", data.winner_team || " ");

    const fan = data.fan_favourite || {};
    set("fanName", fan.driver || "Data unavailable");
    set("fanDetail", fan.votes != null ? `${fan.votes.toLocaleString()} votes · Driver of the Day` : "Driver of the Day");

    const fastest = data.fastest_lap || {};
    set("fastestName", fastest.driver || "Data unavailable");
    set("fastestDetail", fastest.time || (fastest.seconds ? `${fastest.seconds} seconds · Lap ${fastest.lap}` : "Fastest recorded lap"));

    const pit = data.best_pit_stop || {};
    set("pitName", pit.driver || "Data unavailable");
    set("pitDetail", pit.stationary > 0 ? `${pit.stationary.toFixed(3)} seconds · Lap ${pit.lap}` : "Stationary stop duration unavailable");

    const pole = data.pole || {};
    set("poleName", pole.driver || "Data unavailable");
    set("poleDetail", pole.time || "Qualifying performance");

    const gain = data.biggest_gain || {};
    set("gainName", gain.driver || "Data unavailable");
    set("gainDetail", gain.gain != null ? `Gained ${gain.gain} positions · Grid ${gain.grid} → Finish ${gain.position}` : "Position gain unavailable");
}




/* ===== F1 DASHBOARD TABS ===== */
(function () {
    function setupRaceTabs() {
        const main = document.querySelector("main");
        if (!main || document.querySelector(".race-tabs")) return;

        const sections = Array.from(main.querySelectorAll("section.section"));
        if (!sections.length) return;

        function category(section) {
            const heading = section.querySelector("h2, h3");
            const title = heading ? heading.textContent.toLowerCase() : "";

            if (/overview|top performance|standout|big picture/.test(title))
                return "overview";

            if (/lap|pace|consistency|fastest lap/.test(title))
                return "pace";

            if (/pit|tyre|tire|strategy/.test(title))
                return "strategy";

            if (/constructor|team/.test(title))
                return "teams";

            if (/driver|qualifying|position|result|fan|vote/.test(title))
                return "drivers";

            return "overview";
        }

        sections.forEach(section => {
            section.dataset.raceTab = category(section);
        });

        const tabs = [
            ["overview", "OVERVIEW"],
            ["pace", "RACE PACE"],
            ["drivers", "DRIVERS"],
            ["strategy", "STRATEGY"],
            ["teams", "TEAMS"]
        ];

        const nav = document.createElement("nav");
        nav.className = "race-tabs";

        tabs.forEach(([id, label], index) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "race-tab" + (index === 0 ? " active" : "");
            button.textContent = label;

            button.addEventListener("click", () => {
                nav.querySelectorAll(".race-tab").forEach(b =>
                    b.classList.toggle("active", b === button)
                );

                sections.forEach(section => {
                    section.hidden = section.dataset.raceTab !== id;
                });

                sections.filter(s => !s.hidden).forEach(s => {
                    s.classList.remove("dashboard-tab-content");
                    void s.offsetWidth;
                    s.classList.add("dashboard-tab-content");
                });
            });

            nav.appendChild(button);
        });

        main.insertBefore(nav, sections[0]);

        sections.forEach(section => {
            section.hidden = section.dataset.raceTab !== "overview";
        });
    }

    function improveCharts() {
        if (!window.Chart) return;

        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        Chart.defaults.font.size = 11;
        Chart.defaults.color = "#aebbd0";
        Chart.defaults.borderColor = "rgba(160,177,200,0.12)";
        Chart.defaults.elements.line.tension = 0.3;
        Chart.defaults.elements.line.borderWidth = 2.5;
        Chart.defaults.elements.point.radius = 0;
        Chart.defaults.elements.point.hoverRadius = 5;
        Chart.defaults.elements.bar.borderRadius = 5;
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.tooltip.backgroundColor = "#10151e";
        Chart.defaults.plugins.tooltip.borderColor = "#3a4658";
        Chart.defaults.plugins.tooltip.borderWidth = 1;
        Chart.defaults.plugins.tooltip.padding = 11;
    }

    function initialise() {
        setupRaceTabs();
        improveCharts();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialise);
    } else {
        initialise();
    }
})();



/* ===== F1 SIX DASHBOARD IMPROVEMENTS ===== */
(function () {
    "use strict";

    let comparisonChart = null;
    let pitTimelineChart = null;

    const get = id => document.getElementById(id);

    function getSections() {
        return Array.from(document.querySelectorAll("main section.section"));
    }

    function findSection(type) {
        return getSections().find(s => s.dataset.raceTab === type);
    }

    function makePanel(title, id, target) {
        if (!target || get(id)) return;
        const panel = document.createElement("article");
        panel.className = "panel";
        panel.innerHTML =
            '<h3>' + title + '</h3>' +
            '<div class="chart-wrap"><canvas id="' + id + '"></canvas></div>';
        target.appendChild(panel);
    }

    function moveTyreChart() {
        const canvas = get("tyreChart");
        const strategy = findSection("strategy");
        if (!canvas || !strategy) return;

        const panel = canvas.closest("article.panel");
        if (panel && panel.parentElement !== strategy) {
            strategy.appendChild(panel);
        }
    }

    function improveConsistency() {
        if (!window.Chart) return;
        const canvas = get("consistencyChart");
        if (!canvas) return;

        const chart = Chart.getChart(canvas);
        if (!chart || chart.config.type !== "bar") return;

        chart.options.indexAxis = "y";
        chart.options.maintainAspectRatio = false;
        chart.options.scales = chart.options.scales || {};
        chart.options.scales.x = chart.options.scales.x || {};
        chart.options.scales.x.beginAtZero = true;
        chart.options.scales.y = chart.options.scales.y || {};
        chart.options.scales.y.ticks = {
            ...chart.options.scales.y.ticks,
            autoSkip: false
        };
        canvas.parentElement.style.height = "480px";
        chart.update("none");
    }

    function addLapFilter() {
        const canvas = get("lapTrendChart");
        if (!canvas || !window.Chart) return;

        const chart = Chart.getChart(canvas);
        if (!chart) return;

        const panel = canvas.closest("article.panel");
        if (!panel || get("lapDriverFilter")) return;

        const select = document.createElement("select");
        select.id = "lapDriverFilter";
        select.className = "race-tab";
        select.style.marginBottom = "12px";
        select.innerHTML = '<option value="all">All drivers</option>';

        chart.data.datasets.forEach((dataset, index) => {
            const option = document.createElement("option");
            option.value = String(index);
            option.textContent = dataset.label || ("Driver " + (index + 1));
            select.appendChild(option);
        });

        select.addEventListener("change", () => {
            chart.data.datasets.forEach((dataset, index) => {
                chart.setDatasetVisibility(
                    index,
                    select.value === "all" || select.value === String(index)
                );
            });
            chart.update();
        });

        panel.insertBefore(select, canvas.parentElement);
    }

    function addTyreSummary() {
        const canvas = get("tyreChart");
        if (!canvas || !window.Chart) return;

        const chart = Chart.getChart(canvas);
        if (!chart) return;

        const panel = canvas.closest("article.panel");
        if (!panel || get("tyreSummary")) return;

        const labels = chart.data.labels || [];
        const values = chart.data.datasets?.[0]?.data || [];
        const total = values.reduce((sum, value) => sum + Number(value || 0), 0);

        const summary = document.createElement("div");
        summary.id = "tyreSummary";
        summary.className = "tyre-summary";

        summary.innerHTML = labels.map((label, i) => {
            const count = Number(values[i] || 0);
            const percent = total ? (count / total * 100).toFixed(1) : "0.0";
            return '<div class="tyre-stat"><strong>' +
                String(label) + '</strong><span>' + count +
                ' · ' + percent + '%</span></div>';
        }).join("") +
        '<div class="tyre-total">Total tyre records: <strong>' + total + '</strong></div>';

        panel.appendChild(summary);
    }

    function getField(record, candidates) {
        if (!record || typeof record !== "object") return undefined;
        const keys = Object.keys(record);
        const key = keys.find(k =>
            candidates.some(candidate => k.toLowerCase().includes(candidate))
        );
        return key ? record[key] : undefined;
    }

    function addPitTimeline(data) {
        const strategy = findSection("strategy");
        const records = data?.pit_stop_leaderboard;

        if (!strategy || !Array.isArray(records) || !records.length) return;

        let points = records.map(record => {
            const lap = Number(getField(record, ["lap"]));
            const duration = Number(getField(record, ["stationary", "duration", "stop_time", "pit_time"]));
            const driver = getField(record, ["driver"]);
            return { x: lap, y: duration, driver: driver || "Driver" };
        }).filter(p => Number.isFinite(p.x) && p.x > 0 &&
                      Number.isFinite(p.y) && p.y > 0);

        if (!points.length) return;

        if (!get("pitTimelineChart")) {
            const panel = document.createElement("article");
            panel.className = "panel";
            panel.innerHTML =
                '<h3>Pit stop timeline · Lap vs stationary time</h3>' +
                '<div class="chart-wrap"><canvas id="pitTimelineChart"></canvas></div>';
            strategy.appendChild(panel);
        }

        const canvas = get("pitTimelineChart");
        if (pitTimelineChart) pitTimelineChart.destroy();

        const groups = {};
        points.forEach(p => {
            (groups[p.driver] ||= []).push({ x: p.x, y: p.y });
        });

        pitTimelineChart = new Chart(canvas, {
            type: "scatter",
            data: {
                datasets: Object.entries(groups).map(([driver, values]) => ({
                    label: driver,
                    data: values,
                    pointRadius: 5,
                    pointHoverRadius: 8
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { type: "linear", title: { display: true, text: "Race lap" } },
                    y: { title: { display: true, text: "Pit stop duration (seconds)" } }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: context =>
                                context.dataset.label + " · Lap " +
                                context.parsed.x + " · " +
                                context.parsed.y + " seconds"
                        }
                    }
                }
            }
        });
    }

    function addDriverComparison(data) {
        const drivers = data?.lap_trend?.datasets;
        const labels = data?.lap_trend?.labels;
        const target = findSection("drivers");

        if (!target || !Array.isArray(drivers) || drivers.length < 2 ||
            !Array.isArray(labels)) return;

        if (!get("driverComparisonPanel")) {
            const panel = document.createElement("article");
            panel.className = "panel";
            panel.id = "driverComparisonPanel";
            panel.innerHTML = `
                <h3>Driver pace comparison</h3>
                <div class="comparison-controls">
                    <select id="compareDriverA" class="race-tab"></select>
                    <select id="compareDriverB" class="race-tab"></select>
                </div>
                <div class="chart-wrap"><canvas id="driverComparisonChart"></canvas></div>`;
            target.appendChild(panel);
        }

        const a = get("compareDriverA");
        const b = get("compareDriverB");

        [a, b].forEach(select => {
            if (!select.options.length) {
                drivers.forEach((driver, index) => {
                    const option = document.createElement("option");
                    option.value = index;
                    option.textContent = driver.label || "Driver " + (index + 1);
                    select.appendChild(option);
                });
            }
        });

        if (drivers.length > 1 && a.value === b.value) b.value = "1";

        function draw() {
            const selected = [Number(a.value), Number(b.value)];
            const datasets = selected.map(index => {
                const driver = drivers[index];
                return {
                    label: driver.label,
                    data: driver.values,
                    borderWidth: 2.5,
                    pointRadius: 0,
                    tension: 0.3,
                    spanGaps: true
                };
            });

            if (comparisonChart) comparisonChart.destroy();

            comparisonChart = new Chart(get("driverComparisonChart"), {
                type: "line",
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: "index", intersect: false },
                    scales: {
                        x: { title: { display: true, text: "Race lap" } },
                        y: { title: { display: true, text: "Lap-time deviation (ms)" } }
                    }
                }
            });
        }

        if (!a.dataset.bound) {
            a.addEventListener("change", draw);
            b.addEventListener("change", draw);
            a.dataset.bound = "1";
        }
        draw();
    }

    function addStyles() {
        if (get("f1SixImprovementsStyle")) return;
        const style = document.createElement("style");
        style.id = "f1SixImprovementsStyle";
        style.textContent = `
            .tyre-summary {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(120px,1fr));
                gap: 9px;
                margin-top: 14px;
            }
            .tyre-stat {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                padding: 10px;
                border: 1px solid #303744;
                border-radius: 8px;
                background: #111720;
                font-size: 11px;
            }
            .tyre-total {
                grid-column: 1/-1;
                color: #aebbd0;
                font-size: 11px;
                padding: 8px 2px;
            }
            .comparison-controls {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 12px;
            }
            #consistencyChart { min-height: 420px; }
            .pit-layout { grid-template-columns: 1fr; }
        `;
        document.head.appendChild(style);
    }

    function enhance(data) {
        if (!data) return;

        addStyles();
        moveTyreChart();
        improveConsistency();
        addLapFilter();
        addTyreSummary();
        addPitTimeline(data);
        addDriverComparison(data);
    }

    function install() {
        if (typeof window.renderAnalytics !== "function") {
            console.warn("F1 enhancements: renderAnalytics was not found.");
            return;
        }

        if (window.renderAnalytics.__f1Enhanced) return;

        const original = window.renderAnalytics;

        function enhancedRenderAnalytics(data) {
            const result = original.apply(this, arguments);
            requestAnimationFrame(() => {
                try {
                    enhance(data);
                } catch (error) {
                    console.error("F1 dashboard enhancement:", error);
                }
            });
            return result;
        }

        enhancedRenderAnalytics.__f1Enhanced = true;
        window.renderAnalytics = enhancedRenderAnalytics;
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", install);
    } else {
        install();
    }
})();
